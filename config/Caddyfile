# ==============================================================================
# CADDY REVERSE PROXY CONFIGURATION - NPO ODOO DOCKER
# Inisiatif Sistem ERP Terpadu Lembaga Nirlaba Indonesia
# Auto-SSL Let's Encrypt, HTTP/3 (QUIC), & WebSocket Routing Odoo 18 / 19
# ==============================================================================

{
    email {$ACME_EMAIL:admin@npo.id}
    admin off
}

# Domain utama yang diambil dari variabel DOMAIN_NAME di .env
{$DOMAIN_NAME:localhost} {
    encode gzip zstd

    # Batas ukuran payload request (untuk scan berkas legal, akta ikrar wakaf, dokumen mustahik)
    request_body {
        max_size 100MB
    }

    # Header keamanan standar produksi (OWASP / Enterprise Security)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        -Server
    }

    # --------------------------------------------------------------------------
    # 1. Routing WebSocket Odoo 18 / 19 (Port 8072 - gevent/longpolling)
    # Sangat penting untuk live chat, Discuss, notifikasi bus, dan status real-time
    # --------------------------------------------------------------------------
    handle /websocket* {
        reverse_proxy web:8072 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Kompatibilitas Odoo 16/17 longpolling
    handle /longpolling* {
        reverse_proxy web:8072 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # --------------------------------------------------------------------------
    # 2. Routing Trafik Web Standar Odoo (Port 8069)
    # Timeout 3600 detik disiapkan untuk kalkulasi laporan keuangan akuntansi berat
    # --------------------------------------------------------------------------
    handle {
        reverse_proxy web:8069 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            transport http {
                response_header_timeout 3600s
                read_timeout 3600s
                write_timeout 3600s
            }
        }
    }

    # Logging terstruktur ke stdout untuk kemudahan monitoring Docker logs
    log {
        output stdout
        format console
        level INFO
    }
}
