[options]
; ==============================================================================
; KONFIGURASI PRODUKSI ODOO 20 / 19 / 18 LTS - NPO ODOO DOCKER
; Sistem ERP Terpadu Nirlaba Indonesia (PSAK 412, PSAK 109, ISAK 35)
; ==============================================================================

; --- Direktori Addons & Data ---
addons_path = ${ODOO_ADDONS_PATH}
data_dir = /var/lib/odoo

; --- Keamanan & Master Password ---
; Master password untuk manajemen database (digenerate otomatis oleh init-setup.sh)
admin_passwd = ${ADMIN_PASSWORD}

; Proteksi keamanan produksi: Sembunyikan pemilih database dari publik
; Nilai diset False di produksi untuk mencegah enumerasi database & akses sembarangan
list_db = ${LIST_DB}

; Aktifkan proxy mode agar Odoo mengenali header X-Forwarded-* dari Caddy Reverse Proxy
proxy_mode = True

; --- Konfigurasi Port & Jaringan Internal ---
http_interface = 0.0.0.0
http_port = 8069
xmlrpc_port = 8069
gevent_port = 8072

; --- Multi-Worker Tuning (Optimasi VPS 4 GB - 16 GB RAM) ---
; Rumus worker: (CPU Cores * 2) + 1
workers = ${ODOO_WORKERS}
max_cron_threads = 1

; Batas memori per proses worker (dalam bytes)
limit_memory_soft = ${ODOO_LIMIT_MEMORY_SOFT}
limit_memory_hard = ${ODOO_LIMIT_MEMORY_HARD}

; Daur ulang worker setelah melayani request untuk mencegah memory leak
limit_request = 8192

; Batas waktu eksekusi CPU & Real-time (detik) untuk laporan keuangan kompleks
limit_time_cpu = ${ODOO_LIMIT_TIME_CPU}
limit_time_real = ${ODOO_LIMIT_TIME_REAL}

; --- Logging ---
; Log diarahkan ke stdout agar dapat dipantau via 'docker compose logs -f web'
logfile = False
log_level = info

; --- Database Pool Tuning ---
db_maxconn = 64
