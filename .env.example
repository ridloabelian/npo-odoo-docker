# ==============================================================================
# NPO ODOO DOCKER - ENVIRONMENT CONFIGURATION (.env)
# Inisiatif Turnkey ERP Lembaga Nirlaba Indonesia (Wakaf, Zakat & Lembaga Sosial)
# Standar: BWI (PSAK 412), BAZNAS (PSAK 109), Kemensos (ISAK 35)
# ==============================================================================
# Salin file ini menjadi '.env' dan sesuaikan nilainya:
#   cp .env.example .env
# Atau jalankan wizard otomatis:
#   ./init-setup.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. VERSI APLIKASI & DOCKER IMAGES (ODOO 19 / 18 LTS)
# ------------------------------------------------------------------------------
# Image Odoo resmi:
# - odoo:19.0 (Default versi rilis terbaru)
# - odoo:18.0 (Versi LTS sangat stabil untuk produksi)
ODOO_IMAGE=odoo:19.0

# Image PostgreSQL:
# - postgres:17-alpine (Default performa tinggi)
# - postgres:16-alpine (Versi LTS alternatif)
POSTGRES_IMAGE=postgres:17-alpine

# Prefix penamaan container & volume docker (menghindari konflik multi-project)
CONTAINER_PREFIX=npo
VOLUME_PREFIX=npo
NETWORK_NAME=npo_internal_network

# ------------------------------------------------------------------------------
# 1. PROFIL SEKTOR NIRLABA & ADDONS PATH
# ------------------------------------------------------------------------------
# Profil terpilih (1: Wakaf, 2: Zakat, 3: LKS/Panti, 4: Yayasan Terpadu/All-in-One)
NPO_PROFILE=1

# Addons path Odoo di dalam container. Digenerate otomatis oleh init-setup.sh
# Opsi profil:
# [1] Wakaf:     /mnt/extra-addons/npo-core-modules,/mnt/extra-addons/waqf-odoo-modules,/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
# [2] Zakat:     /mnt/extra-addons/npo-core-modules,/mnt/extra-addons/zakat-odoo-modules,/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
# [3] LKS:       /mnt/extra-addons/npo-core-modules,/mnt/extra-addons/lks-odoo-modules,/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
# [4] All-in-One: /mnt/extra-addons/npo-core-modules,/mnt/extra-addons/waqf-odoo-modules,/mnt/extra-addons/zakat-odoo-modules,/mnt/extra-addons/lks-odoo-modules,/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
ODOO_ADDONS_PATH=/mnt/extra-addons/npo-core-modules,/mnt/extra-addons/waqf-odoo-modules,/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons

# URL Repositori Git Modul Ekosistem Nirlaba
NPO_CORE_REPO=https://github.com/ridloabelian/npo-core-modules.git
WAQF_MODULES_REPO=https://github.com/ridloabelian/waqf-odoo-modules.git
ZAKAT_MODULES_REPO=https://github.com/ridloabelian/zakat-odoo-modules.git
LKS_MODULES_REPO=https://github.com/ridloabelian/lks-odoo-modules.git
MODULES_BRANCH=19.0

# ------------------------------------------------------------------------------
# 2. DOMAIN & REVERSE PROXY (CADDY AUTO-SSL LET'S ENCRYPT)
# ------------------------------------------------------------------------------
# Nama domain FQDN yang sudah diarahkan (DNS A record) ke IP publik VPS.
# Contoh: erp.yayasananda.or.id atau zakat.dompetamal.id
# Untuk pengujian lokal gunakan: localhost atau IP server VPS
DOMAIN_NAME=localhost

# Email administrator untuk pendaftaran sertifikat SSL otomatis Let's Encrypt
ACME_EMAIL=admin@npo.id

# Port bind host (biasanya 80 & 443 untuk server web mandiri)
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 3. KREDENSIAL DATABASE POSTGRESQL (ZERO HOST EXPOSURE)
# ------------------------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=odoo
# Password database kuat (akan digenerate otomatis oleh init-setup.sh)
POSTGRES_PASSWORD=GantiDenganPasswordDatabaseYangSangatKuatDanAman123!

# Tuning PostgreSQL Memory Buffer (Optimasi VPS RAM 4 GB - 16 GB)
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=100

# ------------------------------------------------------------------------------
# 4. ODOO MASTER ADMIN PASSWORD & KEAMANAN PRODUKSI
# ------------------------------------------------------------------------------
# Master password untuk akses database manager /web/database/manager
# (Akan digenerate otomatis secara acak oleh init-setup.sh)
ADMIN_PASSWORD=GantiDenganMasterPasswordOdooYangSangatKuatDanAman123!

# Proteksi daftar database di antarmuka web:
# False = Sangat direkomendasikan untuk produksi (mencegah enumerasi & akses publik).
# True  = Gunakan sementara saat membuat database pertama kali jika belum terbuat.
LIST_DB=False

# ------------------------------------------------------------------------------
# 5. RESOURCE & MULTI-WORKER TUNING ODOO
# ------------------------------------------------------------------------------
# Rumus worker ideal: (Jumlah CPU Core * 2) + 1
# Contoh: VPS 2 Core -> 4 atau 5 worker | VPS 4 Core -> 8 atau 9 worker
ODOO_WORKERS=4

# Alokasi memori per worker (dalam bytes)
# 2147483648 = 2048 MB (2 GB) Soft limit
# 2684354560 = 2560 MB (2.5 GB) Hard limit
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=2684354560

# Batas waktu eksekusi CPU & Real time untuk laporan keuangan nirlaba kompleks (detik)
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200

# ------------------------------------------------------------------------------
# 6. PENCADANGAN OTOMATIS & OFFSITE BACKUP (RCLONE)
# ------------------------------------------------------------------------------
# Lokasi penyimpanan arsip backup lokal
BACKUP_DIR=./backups

# Retensi pencadangan lokal (hari). Arsip lebih tua akan dibersihkan otomatis.
BACKUP_RETENTION_DAYS=7

# Integrasi Rclone untuk sinkronisasi offsite ke cloud (Google Drive, S3, Wasabi, Cloudflare R2)
# Kosongkan jika belum menggunakan rclone offsite.
RCLONE_REMOTE=
RCLONE_DEST_PATH=NpoOdooBackups
